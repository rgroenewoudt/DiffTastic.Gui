<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:DiffTastic.Gui.ViewModels"
             xmlns:l="using:DiffTastic.Gui"
             x:Class="DiffTastic.Gui.Controls.BlamePopup"
             x:DataType="vm:BlamePopupViewModel">

    <UserControl.Styles>
        <Style Selector="Button.nav">
            <Setter Property="Padding" Value="10,4" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Background" Value="{DynamicResource NavButtonBackgroundBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource NavButtonBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="4" />
        </Style>
    </UserControl.Styles>

    <Border Background="{DynamicResource PopupBackgroundBrush}" CornerRadius="8" Padding="18,14" MaxWidth="780" MinWidth="420"
            BorderBrush="{DynamicResource PopupBorderBrush}" BorderThickness="1"
            BoxShadow="0 6 24 0 #40000000" Margin="12">
        <StackPanel Spacing="10">
            <TextBlock TextWrapping="Wrap" FontSize="13">
                <Run Text="{Binding KindLabel, Mode=OneWay}" FontWeight="Bold" />
                <Run Text="·" Foreground="{DynamicResource PopupMutedTextBrush}" />
                <Run Text="{Binding LineLabel, Mode=OneWay}" Foreground="{DynamicResource PopupSecondaryTextBrush}" />
            </TextBlock>

            <TextBlock Text="{Binding HeaderText}" TextWrapping="Wrap" FontSize="13" Foreground="{DynamicResource PopupTextBrush}" />

            <Border Background="{DynamicResource MessageBackgroundBrush}" BorderBrush="{DynamicResource MessageBorderBrush}" BorderThickness="3,0,0,0" Padding="12,10">
                <ScrollViewer MaxHeight="260" HorizontalScrollBarVisibility="Disabled">
                    <SelectableTextBlock Text="{Binding Message}" TextWrapping="Wrap"
                                         FontFamily="Cascadia Mono, Consolas, monospace" FontSize="12.5"
                                         Foreground="{DynamicResource PopupTextBrush}" />
                </ScrollViewer>
            </Border>

            <Border Name="ExplanationBox" Background="{DynamicResource AiBackgroundBrush}" BorderBrush="{DynamicResource AiAccentBrush}" BorderThickness="3,0,0,0" Padding="12,8"
                    IsVisible="{Binding HasExplanation}">
                <SelectableTextBlock Text="{Binding Explanation}" TextWrapping="Wrap" FontSize="12.5" Foreground="{DynamicResource AiTextBrush}" />
            </Border>

            <DockPanel LastChildFill="False">
                <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                    <Button Classes="nav" Name="OlderButton" Command="{Binding OlderCommand}" ToolTip.Tip="{l:Tr OlderTip}" Content="{l:Tr Older}" />
                    <TextBlock Text="{Binding PositionText}" VerticalAlignment="Center" MinWidth="44"
                               TextAlignment="Center" FontSize="12" Foreground="{DynamicResource PopupSecondaryTextBrush}" />
                    <Button Classes="nav" Name="NewerButton" Command="{Binding NewerCommand}" ToolTip.Tip="{l:Tr NewerTip}" Content="{l:Tr Newer}" />
                </StackPanel>
                <Button DockPanel.Dock="Right" Classes="nav" Name="CopyShaButton" ToolTip.Tip="{l:Tr CopyShaTip}" Content="{l:Tr CopySha}" />
                <Button DockPanel.Dock="Right" Classes="nav" Name="ExplainButton" Margin="0,0,6,0"
                        Command="{Binding ExplainCommand}" IsVisible="{Binding CanExplain}"
                        ToolTip.Tip="{Binding ExplainToolTip}" Content="{l:Tr Explain}" />
            </DockPanel>
        </StackPanel>
    </Border>
</UserControl>
