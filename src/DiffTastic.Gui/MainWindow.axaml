<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="using:DiffTastic.Gui.ViewModels"
        xmlns:controls="using:DiffTastic.Gui.Controls"
        xmlns:l="using:DiffTastic.Gui"
        mc:Ignorable="d" d:DesignWidth="1200" d:DesignHeight="700"
        x:Class="DiffTastic.Gui.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Title="DiffTastic"
        Width="1400" Height="850"
        Background="{DynamicResource WindowBackgroundBrush}">

    <Window.Resources>
        <StreamGeometry x:Key="IconFirst">M4,4 H6 V20 H4 Z M20,20 L8,12 L20,4 Z</StreamGeometry>
        <StreamGeometry x:Key="IconPrev">M12,6 L20,18 H4 Z</StreamGeometry>
        <StreamGeometry x:Key="IconNext">M12,18 L4,6 H20 Z</StreamGeometry>
        <StreamGeometry x:Key="IconLast">M18,4 H20 V20 H18 Z M4,4 L16,12 L4,20 Z</StreamGeometry>
        <StreamGeometry x:Key="IconOpen">M3,6 H10 L12,8 H21 V19 H3 Z</StreamGeometry>
        <StreamGeometry x:Key="IconExpandAll">M12,2 L18,8 H6 Z M12,22 L6,16 H18 Z M4,11 H20 V13 H4 Z</StreamGeometry>
        <StreamGeometry x:Key="IconCollapse">M12,10 L6,4 H18 Z M12,14 L18,20 H6 Z M4,11 H20 V13 H4 Z</StreamGeometry>
        <StreamGeometry x:Key="IconSettings">F1 M12,8.5 A3.5,3.5 0 1 0 12,15.5 A3.5,3.5 0 1 0 12,8.5 Z M10,2 H14 L14.5,5 L16.5,6 L19,4.5 L21.5,7 L20,9.5 L21,11.5 L24,12 V14 L21,14.5 L20,16.5 L21.5,19 L19,21.5 L16.5,20 L14.5,21 L14,24 H10 L9.5,21 L7.5,20 L5,21.5 L2.5,19 L4,16.5 L3,14.5 L0,14 V12 L3,11.5 L4,9.5 L2.5,7 L5,4.5 L7.5,6 L9.5,5 Z</StreamGeometry>
        <StreamGeometry x:Key="IconReload">M12,4 A8,8 0 1 0 20,12 H17 A5,5 0 1 1 12,7 V10 L16,5.5 L12,1 Z</StreamGeometry>
    </Window.Resources>

    <Window.Styles>
        <Style Selector="Button.tool">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Padding" Value="6,4" />
            <Setter Property="Margin" Value="1,0" />
        </Style>
        <Style Selector="Button.tool PathIcon">
            <Setter Property="Width" Value="14" />
            <Setter Property="Height" Value="14" />
            <Setter Property="Foreground" Value="{DynamicResource ToolIconBrush}" />
        </Style>
        <Style Selector="Button.tool:disabled /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="Transparent" />
        </Style>
        <Style Selector="Button.tool:disabled PathIcon">
            <Setter Property="Foreground" Value="{DynamicResource ToolIconDisabledBrush}" />
        </Style>
        <Style Selector="ToggleButton.tool">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Padding" Value="8,3" />
            <Setter Property="Margin" Value="1,0" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{DynamicResource ToolIconBrush}" />
        </Style>
    </Window.Styles>

    <DockPanel>
        <Border DockPanel.Dock="Top" Background="{DynamicResource BarBackgroundBrush}" BorderBrush="{DynamicResource BarBorderBrush}" BorderThickness="0,0,0,1" Padding="4,3">
            <DockPanel>
            <Button DockPanel.Dock="Right" Classes="tool" Name="SettingsButton" ToolTip.Tip="{l:Tr SettingsTip}">
                <PathIcon Data="{StaticResource IconSettings}" />
            </Button>
            <StackPanel Orientation="Horizontal" Spacing="2">
                <Button Classes="tool" Name="OpenButton" ToolTip.Tip="{l:Tr OpenTip}">
                    <PathIcon Data="{StaticResource IconOpen}" />
                </Button>
                <Button Classes="tool" Name="ReloadButton" ToolTip.Tip="{l:Tr ReloadTip}">
                    <PathIcon Data="{StaticResource IconReload}" />
                </Button>
                <Separator Width="1" Height="20" Background="{DynamicResource BarBorderBrush}" Margin="6,0" />
                <Button Classes="tool" Command="{Binding FirstDiffCommand}" ToolTip.Tip="{l:Tr FirstDiffTip}">
                    <PathIcon Data="{StaticResource IconFirst}" />
                </Button>
                <Button Classes="tool" Command="{Binding PreviousDiffCommand}" ToolTip.Tip="{l:Tr PreviousDiffTip}">
                    <PathIcon Data="{StaticResource IconPrev}" />
                </Button>
                <Button Classes="tool" Command="{Binding NextDiffCommand}" ToolTip.Tip="{l:Tr NextDiffTip}">
                    <PathIcon Data="{StaticResource IconNext}" />
                </Button>
                <Button Classes="tool" Command="{Binding LastDiffCommand}" ToolTip.Tip="{l:Tr LastDiffTip}">
                    <PathIcon Data="{StaticResource IconLast}" />
                </Button>
                <Separator Width="1" Height="20" Background="{DynamicResource BarBorderBrush}" Margin="6,0" />
                <Button Classes="tool" Name="ExpandAllButton" ToolTip.Tip="{l:Tr ExpandAllTip}">
                    <PathIcon Data="{StaticResource IconExpandAll}" />
                </Button>
                <Button Classes="tool" Name="CollapseUnchangedButton" ToolTip.Tip="{l:Tr CollapseUnchangedTip}">
                    <PathIcon Data="{StaticResource IconCollapse}" />
                </Button>
                <Separator Width="1" Height="20" Background="{DynamicResource BarBorderBrush}" Margin="6,0" IsVisible="{Binding IsAiAvailable}" />
                <ToggleButton Classes="tool" Name="AiToggle" Content="{l:Tr AiHeader}" IsVisible="{Binding IsAiAvailable}"
                              IsChecked="{Binding AiEnabled}" ToolTip.Tip="{Binding AiToolTip}" />
                <ToggleButton Classes="tool" Name="SkipNoiseToggle" Content="{l:Tr SkipNoise}" IsVisible="{Binding HasNoise}"
                              IsChecked="{Binding SkipNoise}"
                              ToolTip.Tip="{l:Tr SkipNoiseTip}" />
            </StackPanel>
            </DockPanel>
        </Border>

        <Border DockPanel.Dock="Top" Name="AiBar" Background="{DynamicResource AiBackgroundBrush}" BorderBrush="{DynamicResource AiBarBorderBrush}" BorderThickness="0,0,0,1"
                Padding="10,5" IsVisible="{Binding Analysis, Converter={x:Static ObjectConverters.IsNotNull}}">
            <StackPanel Spacing="3">
                <SelectableTextBlock Name="AiSummary" Text="{Binding Summary}" TextWrapping="Wrap" FontSize="12.5"
                                     Foreground="{DynamicResource AiTextBrush}" />
                <SelectableTextBlock Name="AiNote" Text="{Binding CurrentNoteText}" TextWrapping="Wrap" FontSize="12"
                                     Foreground="{DynamicResource AiNoteTextBrush}"
                                     IsVisible="{Binding CurrentNoteText, Converter={x:Static ObjectConverters.IsNotNull}}" />
                <SelectableTextBlock Name="AiHints" Text="{Binding CurrentHintsText}" TextWrapping="Wrap" FontSize="12"
                                     Foreground="{DynamicResource AiHintTextBrush}"
                                     IsVisible="{Binding CurrentHintsText, Converter={x:Static ObjectConverters.IsNotNull}}" />
            </StackPanel>
        </Border>

        <Border DockPanel.Dock="Bottom" Background="{DynamicResource BarBackgroundBrush}" BorderBrush="{DynamicResource BarBorderBrush}" BorderThickness="0,1,0,0" Padding="8,3">
            <TextBlock Name="StatusBar" Text="{Binding StatusText}" FontSize="12" Foreground="{DynamicResource StatusTextBrush}" />
        </Border>

        <Grid ColumnDefinitions="*,4,*,Auto" Name="PanesGrid">
            <GridSplitter Grid.Column="1" Background="{DynamicResource BarBorderBrush}" ResizeDirection="Columns" />
            <controls:OverviewBar Grid.Column="3" Name="Overview" />
        </Grid>
    </DockPanel>
</Window>
