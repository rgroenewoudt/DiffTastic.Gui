<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:DiffTastic.Gui.ViewModels"
        xmlns:ai="using:DiffTastic.Core.Ai"
        xmlns:l="using:DiffTastic.Gui"
        x:Class="DiffTastic.Gui.SettingsWindow"
        x:DataType="vm:SettingsViewModel"
        Title="{l:Tr SettingsTitle}"
        Width="480" SizeToContent="Height" CanResize="False"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        Background="{DynamicResource DialogBackgroundBrush}">

    <Window.Styles>
        <Style Selector="TextBlock.label">
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="FontSize" Value="13" />
        </Style>
        <Style Selector="TextBlock.hint">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Foreground" Value="{DynamicResource HintTextBrush}" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>
    </Window.Styles>

    <DockPanel>
        <Border DockPanel.Dock="Bottom" Background="{DynamicResource BarBackgroundBrush}" BorderBrush="{DynamicResource BarBorderBrush}" BorderThickness="0,1,0,0" Padding="16,10">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8">
                <Button Name="OkButton" Content="{l:Tr Ok}" IsDefault="True" MinWidth="80" HorizontalContentAlignment="Center" />
                <Button Name="CancelButton" Content="{l:Tr Cancel}" IsCancel="True" MinWidth="80" HorizontalContentAlignment="Center" />
            </StackPanel>
        </Border>

        <StackPanel Margin="20,16" Spacing="14">
            <TextBlock Text="{l:Tr General}" FontSize="15" FontWeight="SemiBold" />

            <Grid ColumnDefinitions="110,*" RowDefinitions="Auto,Auto" RowSpacing="8">
                <TextBlock Classes="label" Text="{l:Tr Language}" />
                <ComboBox Grid.Column="1" Name="LanguageBox" ItemsSource="{Binding Languages}"
                          SelectedItem="{Binding Language}" HorizontalAlignment="Stretch" />

                <TextBlock Grid.Row="1" Classes="label" Text="{l:Tr Theme}" />
                <ComboBox Grid.Row="1" Grid.Column="1" Name="ThemeBox" ItemsSource="{Binding Themes}"
                          SelectedItem="{Binding Theme}" HorizontalAlignment="Stretch" />
            </Grid>

            <CheckBox Name="WhitespaceIsNoiseBox" Content="{l:Tr WhitespaceIsNoise}" IsChecked="{Binding WhitespaceIsNoise}" />

            <TextBlock Text="{l:Tr AiHeader}" FontSize="15" FontWeight="SemiBold" Margin="0,6,0,0" />

            <StackPanel Spacing="4">
                <CheckBox Name="AiEnabledBox" Content="{l:Tr AiEnabled}" IsChecked="{Binding AiEnabled}"
                          IsEnabled="{Binding AnyAiFound}" />
                <TextBlock Classes="hint"
                           Text="{l:Tr AiPrivacyHint}" />
            </StackPanel>

            <Grid ColumnDefinitions="110,*" RowDefinitions="Auto,Auto,Auto,Auto,Auto" RowSpacing="8">
                <TextBlock Classes="label" Text="{l:Tr Provider}" />
                <ComboBox Grid.Column="1" Name="ProviderBox" ItemsSource="{Binding Providers}"
                          SelectedItem="{Binding Provider}" HorizontalAlignment="Stretch" />

                <TextBlock Grid.Row="1" Classes="label" Text="{l:Tr ClaudeModel}" />
                <TextBox Grid.Row="1" Grid.Column="1" Name="ClaudeModelBox" Text="{Binding ClaudeModel}"
                         Watermark="{x:Static ai:ClaudeProvider.DefaultModel}" />
                <TextBlock Grid.Row="2" Grid.Column="1" Classes="hint" Text="{Binding ClaudeStatus}" />

                <TextBlock Grid.Row="3" Classes="label" Text="{l:Tr CodexModel}" />
                <TextBox Grid.Row="3" Grid.Column="1" Name="CodexModelBox" Text="{Binding CodexModel}"
                         Watermark="{x:Static ai:CodexProvider.DefaultModel}" />
                <TextBlock Grid.Row="4" Grid.Column="1" Classes="hint" Text="{Binding CodexStatus}" />
            </Grid>

            <TextBlock Classes="hint" Text="{l:Tr ModelHint}" />
        </StackPanel>
    </DockPanel>
</Window>
